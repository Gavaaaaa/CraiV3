# .env.example — copie para .env e preencha
# cp .env.example .env

# ── Ambiente ───────────────────────────────────────────────────────
# development | demo → habilita os endpoints /simulate/*
# qualquer outro valor (ou ausente) → /simulate/* respondem 403
ENV=development

# ── Anthropic (obrigatório para dunning e mensagens de retenção) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (opcional — simulação local funciona sem) ───────────────
STRIPE_SECRET_KEY=sk_test_...
# Obrigatório para /webhooks/stripe: sem ele todo request é rejeitado
# com 401 (assinatura HMAC-SHA256 do header 'stripe-signature').
STRIPE_WEBHOOK_SECRET=whsec_...

# ── HubSpot CRM (opcional — sem token roda em modo simulação) ──────
# 1. hubspot.com → Settings → Integrations → Private Apps → Create
# 2. Permissões: crm.objects.contacts.write + crm.objects.deals.write
# 3. No HubSpot, criar 2 pipelines:
#    - "crai_recovery"  (stages: diagnosing, retrying, dunning_sent, recovered, lost)
#    - "crai_retention" (stages: risk_detected, offer_sent, retained, churned)
HUBSPOT_TOKEN=pat-na1-...

# ── Pix Automático (PSP de Pix — Iugu, Pagar.me ou outro) ─────────────
# Obrigatório para /webhooks/pix-automatico: shared secret do HMAC-SHA256 do
# header 'x-pix-signature'. Sem ele todo request é rejeitado com 401.
PIX_WEBHOOK_SECRET=...

# ── Criptografia de campos sensíveis ──────────────────────────────────
# Chave Fernet usada para cifrar a chave Pix do pagador antes de arquivá-la
# para conciliação. Sem ela, o arquivamento falha em vez de gravar em texto
# puro (fail closed). Gerar com:
#   python -c "from crai.security.tokenization import generate_key; print(generate_key())"
CRAI_ENCRYPTION_KEY=...

# ── Segment (opcional — simulação via /simulate/churn-risk funciona sem) ──
SEGMENT_WRITE_KEY=...
# Obrigatório para /webhooks/segment: shared secret usado no HMAC-SHA1 do
# header 'x-signature'. Sem ele todo request é rejeitado com 401.
SEGMENT_WEBHOOK_SECRET=...

# ── Tom do churn voluntário (opcional — ambos têm default seguro) ─────
# Limiar de MRR (R$/mês) acima do qual o cliente é tratado como CRÍTICO
# mesmo com risco baixo, recebendo a mensagem de alto cuidado. Ausente ou
# ilegível → R$ 2000.00.
CRAI_HIGH_VALUE_MRR_THRESHOLD=2000.00
# Nome que assina as mensagens críticas ("— {nome}, time CRAI"). Ausente →
# a mensagem sai SEM assinatura: o prompt proíbe inventar um nome, porque um
# nome que não existe é uma pessoa que o cliente vai procurar na resposta.
CRAI_CS_SIGNATURE_NAME=

# ── Desfecho de retenção (churn voluntário, Sprint 4) ─────────────────
# Obrigatório para /webhooks/retention-outcome: shared secret do HMAC-SHA1 do
# header 'x-signature' — MESMO formato do Segment, segredo PRÓPRIO, porque
# quem envia é o backend do cliente e não o Segment. Sem ele todo request é
# rejeitado com 401. Este endpoint move o posterior do bandit: aberto, qualquer
# um faria a CRAI acreditar que uma oferta converte 100%.
RETENTION_OUTCOME_WEBHOOK_SECRET=...
# "1" liga o MODO SIMULAÇÃO: o grafo passa por track_outcome, que SORTEIA o
# aceite. Existe para a demo e para os testes rodarem sem webhook externo.
# Ausente ou qualquer outro valor = produção, onde o grafo termina no envio e o
# desfecho chega pelo webhook acima. NUNCA ligar em produção: o bandit
# aprenderia com dado inventado.
CRAI_SIMULATE_OUTCOMES=
# Caminho alternativo do log de ciclos (dataset de treino). Vazio = o padrão,
# crai/data/retention_cycles.db. Os testes apontam para tmp_path por aqui.
CRAI_RETENTION_DB=
