# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Modelos treinados (regeneraveis via train())
# Padrao com /* (e nao com /) porque o git nao reabre um diretorio ignorado:
# a excecao abaixo so funciona se o diretorio em si nao estiver ignorado.
crai/models/*
# ...exceto a calibracao: e um punhado de numeros medidos sobre a amostra real,
# nao um binario. Precisa estar no clone limpo, senao a demo cai em
# [SYNTH] MODO NAO-CALIBRADO na frente da banca.
!crai/models/calibracao.json

# Dados
# Fonte A (Olist) e CC BY-NC-SA: fica fora do git e e regenerada de forma
# deterministica por `python -m crai.scripts.preparar_amostra_real`.
crai/data/real/
# Dataset sintetico de treino (regeneravel, ~MBs)
crai/data/synthetic/
# Pacote de modelos da demo (gerado no Sprint 4)
crai/models_demo.tar.gz

# Logs de auditoria SHAP (regeneraveis)
crai/logs/

# Chaves Pix cifradas (conciliacao financeira) — nunca versionar
crai/vault/

# Ambiente
.env
.env.*
!.env.example
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Relatorios locais de acompanhamento (nao fazem parte do codigo)
relatorio_*.txt

# Cobertura
.coverage
htmlcov/

# Config local do Claude Code — permissões e preferências da máquina de quem
# está rodando, não do projeto. settings.local.json em particular é pessoal
# por convenção (mesmo espírito de um .env.local); não deve ir para um repo
# compartilhado.
.claude/
