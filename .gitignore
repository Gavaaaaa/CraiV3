# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Modelos treinados (regeneraveis via train())
# Padrao com /* (e nao com /) porque o git nao reabre um diretorio ignorado:
# a excecao abaixo so funciona se o diretorio em si nao estiver ignorado.
app/models/*
# ...exceto a calibracao: e um punhado de numeros medidos sobre a amostra real,
# nao um binario. Precisa estar no clone limpo, senao a demo cai em
# [SYNTH] MODO NAO-CALIBRADO na frente da banca.
!app/models/calibracao.json

# Dados
# Fonte A (Olist) e CC BY-NC-SA: fica fora do git e e regenerada de forma
# deterministica por `python -m crai.scripts.preparar_amostra_real`.
app/data/real/
# Dataset sintetico de treino (regeneravel, ~MBs)
app/data/synthetic/
# Pacote de modelos da demo (gerado no Sprint 4)
app/models_demo.tar.gz
# Log de ciclos de retencao — e o DATASET de treino do churn voluntario, e
# carrega dado de cliente real (mrr, uso, desfecho). Nunca versionar: o
# formato esta documentado em churn_voluntary/README_treino.md e o arquivo se
# regenera sozinho a cada ciclo.
app/data/retention_cycles.db
app/data/retention_cycles.db-journal
# Churn involuntario: dataset de ciclos de recuperacao e planos de retentativa
# pendentes. Sao estado de EXECUCAO, nao fonte do repositorio — versiona-los
# faria o dataset de treino de uma maquina virar o de outra no merge.
app/data/recovery_cycles.db
app/data/recovery_cycles.db-journal
app/data/pix_retry_state.json

# Logs de auditoria SHAP (regeneraveis)
app/logs/

# Chaves Pix cifradas (conciliacao financeira) — nunca versionar
app/vault/

# Ambiente
.env
.env.*
!.env.example
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Relatorios locais de acompanhamento (nao fazem parte do codigo)
relatorio_*.txt

# Artefatos gerados ao rodar o relatorio.py / painel (scripts/painel.py, api/painel.py):
# banco SQLite local e HTML de saida sao estado de execucao, regenerados a
# cada rodada — nunca versionar.
app/relatorio_execucao.html
app/relatorio_clientes.db
app/painel_teste.db
app/clientes_local.db

# Cobertura
.coverage
htmlcov/

# Config local do Claude Code — permissões e preferências da máquina de quem
# está rodando, não do projeto. settings.local.json em particular é pessoal
# por convenção (mesmo espírito de um .env.local); não deve ir para um repo
# compartilhado.
.claude/
