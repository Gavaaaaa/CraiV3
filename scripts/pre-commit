#!/bin/sh
#
# CRAI — hook de pre-commit: barreira contra vazamento de segredos.
#
# Ativacao (a partir da raiz do repositorio):
#     git config core.hooksPath scripts
#
# Bypass pontual (usar so com certeza absoluta):
#     git commit --no-verify
#
# Verifica duas coisas nos arquivos ESTAGIADOS:
#   1. Nenhum arquivo .env / .env.* — sem excecao. O repositorio nao tem
#      arquivo de exemplo de .env; as variaveis estao em docs/CONFIGURACAO.md.
#   2. Nenhum valor que pareca uma chave real de API
#
# Sem dependencias externas: apenas sh + git + grep.

BLOQUEIOS=0

# ── 1. Arquivos .env ──────────────────────────────────────────────────
ARQUIVOS_ENV=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env($|\.)')

if [ -n "$ARQUIVOS_ENV" ]; then
  echo "[SECURITY] Commit bloqueado — arquivo .env estagiado:"
  echo "$ARQUIVOS_ENV" | sed 's/^/[SECURITY]   - /'
  echo "[SECURITY] Remova do stage: git rm --cached <arquivo>"
  BLOQUEIOS=1
fi

# ── 2. Padroes de chave real no conteudo estagiado ────────────────────
# Placeholders escritos em documentacao (sk-ant-..., whsec_...) nao casam,
# pois os padroes exigem 8+ caracteres alfanumericos reais apos o prefixo.
PADROES='sk-ant-[A-Za-z0-9_-]{8,}'
PADROES="$PADROES|sk_live_[A-Za-z0-9]{8,}"
PADROES="$PADROES|sk_test_[A-Za-z0-9]{8,}"
PADROES="$PADROES|rk_live_[A-Za-z0-9]{8,}"
PADROES="$PADROES|whsec_[A-Za-z0-9]{8,}"
PADROES="$PADROES|pat-na1-[A-Za-z0-9-]{12,}"
PADROES="$PADROES|AKIA[0-9A-Z]{16}"
PADROES="$PADROES|gh[pousr]_[A-Za-z0-9]{20,}"

for ARQUIVO in $(git diff --cached --name-only --diff-filter=ACM); do
  [ -f "$ARQUIVO" ] || continue
  ACHADOS=$(git show ":$ARQUIVO" 2>/dev/null | grep -nE "$PADROES")
  if [ -n "$ACHADOS" ]; then
    echo "[SECURITY] Commit bloqueado — possivel chave real em $ARQUIVO:"
    echo "$ACHADOS" | cut -c1-80 | sed 's/^/[SECURITY]   /'
    BLOQUEIOS=1
  fi
done

if [ "$BLOQUEIOS" -ne 0 ]; then
  echo "[SECURITY] Nenhum segredo deve entrar no historico do git."
  exit 1
fi

echo "[SECURITY] Verificacao de segredos OK."
exit 0
